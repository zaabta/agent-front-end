# Development API target is proxied by Vite; use a browser-reachable URL.
VITE_API_PROXY_TARGET=http://127.0.0.1:3220
VITE_DEV_AUTH_PROXY_TARGET=http://127.0.0.1:3211
# For production, set VITE_API_BASE_URL to the public API origin.
# Never put JWT signing secrets or bearer tokens in Vite variables.
VITE_APP_NAME=SitePilot AI
